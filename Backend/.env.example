# Copy this file to .env and fill in real values.
# NEVER commit the real .env - it is git-ignored.

PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=enterprise_crm

# JWT
# Generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. The server refuses to start without it.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Password reset token lifetime in minutes
RESET_TOKEN_TTL_MINUTES=30

# File uploads
MAX_UPLOAD_SIZE_MB=2

# Frontend origin allowed by CORS (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173
